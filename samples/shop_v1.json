{
  "openapi": "3.0.0",
  "info": {"title": "Shop API", "version": "1.0"},
  "paths": {
    "/customers": {
      "get": {"summary": "List customers", "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Customer"}}}}}}},
      "post": {"summary": "Create customer", "responses": {"201": {"description": "created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Customer"}}}}}}
    },
    "/customers/{id}": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}],
      "get": {"summary": "Get customer", "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Customer"}}}}}}
    }
  },
  "components": {"schemas": {"Customer": {"type": "object", "required": ["id", "email"], "properties": {"id": {"type": "integer"}, "email": {"type": "string"}, "name": {"type": "string"}}}}}
}